# Copie ce fichier en ".env.local" (jamais en .env.local.example) et remplis
# les valeurs avec celles de ton projet Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-publique-ici

# Clé secrète Stripe (Developers > API keys). Commence par sk_test_ en mode
# test ou sk_live_ en production. NE JAMAIS exposer cette clé côté client -
# elle n'est utilisée que dans les routes /app/api/stripe/*.
STRIPE_SECRET_KEY=sk_test_ta-cle-secrete-ici
